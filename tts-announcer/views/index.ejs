<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 안내방송 시스템</title>
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.all.min.js"></script>
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.8);
            --glass-border: rgba(255, 255, 255, 0.3);
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.4);
            --secondary: #ec4899;
            --accent: #10b981;
            --danger: #f43f5e;
            --dark-bg: #0f172a;
            --text-main: #1e293b;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Pretendard', sans-serif;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            color: var(--text-main);
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            animation: fadeInDown 0.8s ease-out;
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 0;
            letter-spacing: -0.02em;
        }

        .header p {
            color: var(--text-muted);
            margin-top: 10px;
            font-size: 1.1rem;
        }

        .main-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 900px;
            padding: 40px;
            animation: fadeInUp 0.8s ease-out;
        }

        .controls-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        @media (max-width: 768px) {
            .controls-grid { grid-template-columns: 1fr; }
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .label {
            font-size: 0.95rem;
            font-weight: 600;
            color: #4b5563;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .select, .textarea, .input {
            appearance: none;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            outline: none;
        }

        .select:focus, .textarea:focus, .input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-glow);
            transform: translateY(-2px);
        }

        .textarea {
            min-height: 180px;
            resize: none;
            line-height: 1.6;
        }

        /* Speed Slider */
        .slider-container {
            background: rgba(255, 255, 255, 0.6);
            padding: 15px 20px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }

        .slider {
            width: 100%;
            height: 6px;
            background: #cbd5e1;
            border-radius: 5px;
            outline: none;
            accent-color: var(--primary);
        }

        .slider-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .button-group {
            display: grid; grid-template-columns: 2fr 1fr; gap: 15px;
            margin-top: 30px;
        }

        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 24px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
        }

        .btn-primary {
            background: linear-gradient(to right, var(--primary), #4f46e5);
            color: white;
            box-shadow: 0 10px 15px -3px var(--primary-glow);
        }

        .btn-primary:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 25px -5px var(--primary-glow);
        }

        .btn-stop {
            background: #f1f5f9;
            color: #475569;
        }

        .btn-stop:hover {
            background: #e2e8f0;
            color: var(--danger);
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* Quick Templates */
        .templates {
            margin-top: 40px;
            width: 100%;
            max-width: 900px;
            animation: fadeInUp 1s ease-out;
        }

        .templates-title {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 20px;
            color: #475569;
            text-align: left;
        }

        .templates-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }

        .template-btn {
            background: white;
            border: 1px solid #e2e8f0;
            padding: 15px;
            border-radius: 16px;
            text-align: left;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .template-btn:hover {
            border-color: var(--primary);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
            transform: translateY(-5px);
        }

        .template-btn span:first-child {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--primary);
        }

        .template-btn span:last-child {
            font-size: 0.85rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .spinner {
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,0.3);
            border-top: 3px solid white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            display: none;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>AI Announcement System</h1>
        <p>현대적이고 직관적인 AI 안내방송 인터페이스</p>
    </div>

    <div class="main-card">
        <div class="controls-grid">
            <div class="input-group">
                <label class="label"><i class="fa-solid fa-microphone"></i> 음성 엔진</label>
                <select id="voiceSelect" class="select">
                    <option value="ko-KR-SunHiNeural">여성 - 선희 (Standard)</option>
                    <option value="ko-KR-InJoonNeural">남성 - 인준 (Announcer)</option>
                    <option value="ko-KR-HyunsuMultilingualNeural">남성 - 현수 (Multilingual)</option>
                </select>
            </div>
            <div class="input-group">
                <label class="label"><i class="fa-solid fa-repeat"></i> 반복 횟수</label>
                <select id="repeatSelect" class="select">
                    <option value="1">1회 방송</option>
                    <option value="2" selected>2회 반복</option>
                    <option value="3">3회 반복</option>
                    <option value="5">5회 반복</option>
                </select>
            </div>
        </div>

        <div class="input-group" style="margin-bottom: 25px;">
            <label class="label"><i class="fa-solid fa-align-left"></i> 방송 문구</label>
            <textarea id="announcementText" class="textarea" placeholder="방송할 내용을 입력하세요..."></textarea>
        </div>

        <div class="slider-container">
            <div class="slider-header">
                <span><i class="fa-solid fa-bolt"></i> 방송 속도</span>
                <span id="speedValue">x1.0</span>
            </div>
            <input type="range" id="rateSlider" class="slider" min="0.5" max="2.0" step="0.1" value="1.0">
        </div>

        <div class="button-group">
            <button id="playBtn" class="btn btn-primary" onclick="playTTS()">
                <div id="playSpinner" class="spinner"></div>
                <i id="playIcon" class="fa-solid fa-play"></i>
                <span id="playText">방송 시작</span>
            </button>
            <button class="btn btn-stop" onclick="stopTTS()">
                <i class="fa-solid fa-stop"></i> 정지
            </button>
        </div>
    </div>

    <div class="templates">
        <div class="templates-title">자주 사용하는 템플릿</div>
        <div class="templates-grid">
            <div class="template-btn" onclick="applyTemplate('이동 주차', '차량번호 1 2 3 가 4 5 6 7 차주님께서는 지금 즉시 이동주차 바랍니다.')">
                <span>이동 주차</span>
                <span>차량번호 123가 4567 차주님...</span>
            </div>
            <div class="template-btn" onclick="applyTemplate('코드 블루', '긴급 공지, 코드 블루. 수술실. 긴급 공지, 코드 블루. 수술실.')">
                <span>코드 블루</span>
                <span>긴급 공지, 코드 블루. 수술실...</span>
            </div>
            <div class="template-btn" onclick="applyTemplate('정시 알림', '현재 시각은 오후 6시입니다. 오늘 하루도 수고 많으셨습니다.')">
                <span>정시 알림</span>
                <span>현재 시각은 오후 6시입니다...</span>
            </div>
            <div class="template-btn" onclick="applyTemplate('점심 안내', '즐거운 점심 시간입니다. 맛있는 식사 하시기 바랍니다.')">
                <span>점심 안내</span>
                <span>즐거운 점심 시간입니다...</span>
            </div>
        </div>
    </div>

    <script>
        let currentAudio = null;

        const rateSlider = document.getElementById('rateSlider');
        const speedValue = document.getElementById('speedValue');
        rateSlider.oninput = () => speedValue.textContent = 'x' + parseFloat(rateSlider.value).toFixed(1);

        function applyTemplate(title, text) {
            document.getElementById('announcementText').value = text;
            Swal.fire({
                icon: 'success',
                title: '템플릿 적용됨',
                text: `${title} 멘트가 입력되었습니다.`,
                timer: 1500,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }

        function stopTTS() {
            if (currentAudio) {
                currentAudio.pause();
                currentAudio.currentTime = 0;
            }
            resetUI();
        }

        function resetUI() {
            const playBtn = document.getElementById('playBtn');
            const spinner = document.getElementById('playSpinner');
            const icon = document.getElementById('playIcon');
            const text = document.getElementById('playText');

            playBtn.disabled = false;
            spinner.style.display = 'none';
            icon.style.display = 'inline-block';
            text.textContent = '방송 시작';
        }

        async function playTTS() {
            const textToSpeak = document.getElementById('announcementText').value.trim();
            const voice = document.getElementById('voiceSelect').value;
            const count = document.getElementById('repeatSelect').value;
            const rate = rateSlider.value;

            if (!textToSpeak) {
                Swal.fire({ icon: 'error', title: '내용 입력 필요', text: '방송할 내용을 입력해주세요.' });
                return;
            }

            // Update UI
            const playBtn = document.getElementById('playBtn');
            const spinner = document.getElementById('playSpinner');
            const icon = document.getElementById('playIcon');
            const text = document.getElementById('playText');

            playBtn.disabled = true;
            spinner.style.display = 'inline-block';
            icon.style.display = 'none';
            text.textContent = '데이터 준비 중...';

            try {
                const response = await fetch('/api/tts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: textToSpeak, voice, count, rate })
                });

                if (!response.ok) throw new Error('서버 통신 오류');

                const blob = await response.blob();
                const url = URL.createObjectURL(blob);
                
                if (currentAudio) {
                    currentAudio.pause();
                    currentAudio.currentTime = 0;
                }

                currentAudio = new Audio(url);
                currentAudio.onplay = () => {
                    text.textContent = '방송 중...';
                };
                currentAudio.onended = () => {
                    resetUI();
                    URL.revokeObjectURL(url);
                };

                await currentAudio.play();
            } catch (err) {
                console.error(err);
                Swal.fire({ icon: 'error', title: '방송 오류', text: err.message });
                resetUI();
            }
        }
    </script>
</body>
</html>
